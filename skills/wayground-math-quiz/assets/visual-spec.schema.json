{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wayground-math-quiz/visual-spec.schema.json",
  "title": "Wayground Visual Question Specification",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "mode",
    "canvas",
    "alt",
    "answer",
    "lockedFacts",
    "review",
    "layers"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "mode": {
      "enum": ["deterministic", "source-crop", "ai-composite"]
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "type": "integer", "minimum": 640, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 480, "maximum": 3840 },
        "background": { "type": "string" }
      }
    },
    "alt": { "type": "string", "minLength": 1 },
    "answer": {
      "type": "object",
      "required": ["optionIds", "correctOptionId", "unique"],
      "properties": {
        "optionIds": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "correctOptionId": { "type": "string", "minLength": 1 },
        "unique": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "prompt": { "type": "string" },
        "generatedAt": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "lockedFacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "value", "renderedBy"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "value": {},
          "renderedBy": { "enum": ["overlay", "source"] },
          "description": { "type": "string" }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["mathChecked", "visualChecked", "ambiguityChecked"],
      "properties": {
        "mathChecked": { "type": "boolean" },
        "visualChecked": { "type": "boolean" },
        "ambiguityChecked": { "type": "boolean" },
        "reviewer": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": [
              "rect",
              "line",
              "circle",
              "ellipse",
              "polygon",
              "image",
              "text"
            ]
          },
          "path": { "type": "string" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "width": { "type": "number" },
          "height": { "type": "number" },
          "x1": { "type": "number" },
          "y1": { "type": "number" },
          "x2": { "type": "number" },
          "y2": { "type": "number" },
          "radius": { "type": "number" },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [{ "type": "number" }, { "type": "number" }],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "text": { "type": "string" },
          "font": { "type": "string" },
          "fontSize": { "type": "number" },
          "weight": { "type": ["string", "number"] },
          "fill": { "type": "string" },
          "stroke": { "type": "string" },
          "strokeWidth": { "type": "number" },
          "fit": { "enum": ["cover", "contain", "stretch"] },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
